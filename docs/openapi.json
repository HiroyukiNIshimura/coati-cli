            "name": "workspaceIdOrCode",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "アイテム番号（ワークスペース内連番）",
            "in": "path",
            "name": "itemNumber",
            "required": true,
            "schema": {
              "format": "int32",
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
