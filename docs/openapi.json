  "info": {
    "description": "External API schema.",
    "title": "Coati External API",
    "version": "1.0.0"
  },
  "openapi": "3.0.4",
  "paths": {
    "/api/external/ping": {
      "post": {
        "description": "受け取ったメッセージをそのまま返却します。\nAPIキー認証の疎通確認に使用してください。",
        "requestBody": {
          "content": {
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PingRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PingRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ],
        "summary": "疎通確認用エンドポイント",
        "tags": [
          "ExternalAPI"
        ]
      }
    },
    "/api/external/workspaces/{workspaceIdOrCode}/items": {
      "get": {
        "description": "ページネーション（1ページあたり20件固定）に対応しています。\nアクティブフラグ（isActive）、アーカイブフラグ（isArchived）、下書きフラグ（isDraft）でのフィルタリングが可能です。\n認証された API キーの組織に属するワークスペースのみアクセス可能です。",
        "parameters": [
          {
            "description": "ワークスペースIDまたはコード",
            "in": "path",
            "name": "workspaceIdOrCode",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "ページ番号（1始まり、省略時は1）",
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "description": "アクティブフラグフィルタ（nullの場合は全件）",
            "in": "query",
            "name": "isActive",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "アーカイブフラグフィルタ（nullの場合は全件）",
            "in": "query",
            "name": "isArchived",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "下書きフラグフィルタ（nullの場合は全件）",
            "in": "query",
            "name": "isDraft",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalItemListResponse"
                }
              }
            },
            "description": "アイテム一覧の取得に成功"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "認証エラー"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "ワークスペースが見つからない"
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ],
        "summary": "指定ワークスペース内の全アイテムを取得する",
        "tags": [
          "ExternalAPI"
        ]
      }
    },
    "/api/external/workspaces/{workspaceIdOrCode}/items/{itemNumber}": {
      "get": {
