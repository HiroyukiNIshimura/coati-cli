          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "ワークスペースまたはアイテムが見つからない"
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ],
        "summary": "指定ワークスペース内の指定アイテムを取得する",
        "tags": [
          "ExternalAPI"
        ]
      }
    },
